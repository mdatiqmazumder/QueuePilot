#!/usr/bin/env bash
set -euo pipefail
INSTALL_DIR=/opt/queuepilot
SERVICE=queuepilot
if [[ $EUID -ne 0 ]]; then exec sudo -- "$0" "$@"; fi
if [[ ! -f "$INSTALL_DIR/.env" ]]; then echo 'Run install.sh first.'; exit 1; fi
setup_ui_updates() {
  local panel_user
  panel_user=$(systemctl show "$SERVICE" -p User --value)
  id "$panel_user" >/dev/null
  install -d -o "$panel_user" -m 0700 /var/lib/queuepilot-updates
  cat > /etc/systemd/system/queuepilot-update.service <<'UNIT'
[Unit]
Description=QueuePilot application update
After=network-online.target
[Service]
Type=oneshot
ExecStartPre=/usr/bin/rm -f /var/lib/queuepilot-updates/request
ExecStart=/usr/local/bin/queuepilot update
TimeoutStartSec=7200
UNIT
  cat > /etc/systemd/system/queuepilot-update.path <<'UNIT'
[Unit]
Description=Watch for QueuePilot update requests
[Path]
PathExists=/var/lib/queuepilot-updates/request
Unit=queuepilot-update.service
[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable --now queuepilot-update.path
}
update_state() {
  /usr/bin/python3 - "$1" <<'PY'
import json, os, sys
path = '/var/lib/queuepilot-update-state.json'
with open(path + '.tmp', 'w') as file:
    json.dump({'status': sys.argv[1]}, file)
os.chmod(path + '.tmp', 0o644)
os.replace(path + '.tmp', path)
PY
}
update_panel() (
  set -euo pipefail
  local stage backup stopped=0
  exec 9>/run/lock/queuepilot-update.lock
  flock -n 9 || { echo 'Another update is already running.'; exit 1; }
  stage=$(mktemp -d)
  backup="${INSTALL_DIR}-backup-$(date +%Y%m%d-%H%M%S)"
  recover() {
    local result=$?
    if (( result != 0 && stopped )); then
      echo "Update failed. Restoring $backup"
      cp -a "$backup/." "$INSTALL_DIR/"
      if [[ ! -f "$backup/.installed-revision" ]]; then rm -f "$INSTALL_DIR/.installed-revision"; fi
      systemctl start "$SERVICE" || true
    fi
    if (( result != 0 )); then update_state failed; fi
    return "$result"
  }
  trap recover EXIT
  update_state running
  echo 'Downloading QueuePilot...'
  curl -fsSL --retry 3 -H 'User-Agent: QueuePilot' https://api.github.com/repos/mdatiqmazumder/QueuePilot/commits/main -o "$stage/revision.json"
  local revision
  revision=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha"])' "$stage/revision.json")
  [[ "$revision" =~ ^[a-f0-9]{40}$ ]]
  curl -fL --retry 3 "https://github.com/mdatiqmazumder/QueuePilot/archive/$revision.tar.gz" -o "$stage/source.tar.gz"
  mkdir "$stage/source"
  /usr/bin/python3 - "$stage" <<'PY'
import sys, tarfile
from pathlib import Path
stage = Path(sys.argv[1])
with tarfile.open(stage / 'source.tar.gz') as archive:
    archive.extractall(stage / 'source', filter='data')
PY
  local source="$stage/source/QueuePilot-$revision"
  test -f "$source/panel/app.py"
  test -f "$source/requirements.txt"
  test -f "$source/bin/queuepilot"
  cp -a "$INSTALL_DIR" "$backup"
  stopped=1
  systemctl stop "$SERVICE"
  cp -R "$source/panel/." "$INSTALL_DIR/panel/"
  cp "$source/requirements.txt" "$source/README.md" "$INSTALL_DIR/"
  "$INSTALL_DIR/.venv/bin/pip" install -r "$INSTALL_DIR/requirements.txt"
  systemctl start "$SERVICE"
  sleep 3
  systemctl is-active --quiet "$SERVICE"
  install -m 0755 "$source/bin/queuepilot" /usr/local/bin/queuepilot
  printf '%s\n' "$revision" > "$INSTALL_DIR/.installed-revision"
  /usr/local/bin/queuepilot setup-ui-updates
  stopped=0
  update_state success
  echo "QueuePilot updated. Backup: $backup"
)
action() {
  case "$1" in
    start|stop|restart) systemctl "$1" "$SERVICE"; systemctl is-active "$SERVICE" || [[ "$1" == stop ]] ;;
    status) systemctl status "$SERVICE" --no-pager || true ;;
    logs) journalctl -u "$SERVICE" -n 100 --no-pager ;;
    follow) journalctl -u "$SERVICE" -f ;;
    enable|disable) systemctl "$1" "$SERVICE" ;;
    password) (cd "$INSTALL_DIR" && .venv/bin/python -m panel.admin) ;;
    settings) (cd "$INSTALL_DIR" && .venv/bin/python -m panel.configure); systemctl restart "$SERVICE"; echo 'Settings saved; restarted.' ;;
    doctor) (cd "$INSTALL_DIR" && .venv/bin/python -m panel.doctor) ;;
    update) update_panel ;;
    setup-ui-updates) setup_ui_updates ;;
    help) echo 'queuepilot [start|stop|restart|status|logs|follow|enable|disable|settings|password|doctor|update|help]' ;;
    *) echo "Unknown command: $1"; return 1 ;;
  esac
}
if [[ $# -gt 0 ]]; then action "$1"; exit $?; fi
while true; do
  printf '\n  QUEUEPILOT · SERVER CONTROL\n  ───────────────────────────\n'
  printf '  1) Start panel       2) Stop panel\n  3) Restart panel     4) Service status\n'
  printf '  5) View logs         6) Settings / port\n  7) Reset password    8) Health diagnostics\n'
  printf '  9) Enable at boot   10) Disable at boot\n 11) Update QueuePilot\n  0) Exit\n\n'
  read -r -p '  Select an option: ' choice || exit 0
  case "$choice" in
    1) action start ;; 2) action stop ;; 3) action restart ;; 4) action status ;;
    5) action logs ;; 6) action settings ;; 7) action password ;; 8) action doctor ;;
    9) action enable ;; 10) action disable ;; 11) action update ;; 0|q|exit) exit 0 ;; *) echo 'Invalid option' ;;
  esac
done
